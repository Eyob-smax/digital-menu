# Neon Postgres connection string (paste the pooled URL from the Neon console)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-char-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded first admin account (change the password before going live)
SEED_ADMIN_EMAIL="admin@restaurant.local"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Owner"

# Set to 1 only if your network can't reach Neon's IPv6-only pooled host.
# Uses the direct (unpooled) endpoint instead. Leave unset in production.
# DATABASE_URL_UNPOOLED_ONLY=1
